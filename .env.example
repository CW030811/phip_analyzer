# Anthropic API Key（必填）
ANTHROPIC_API_KEY=sk-ant-...

# 可选：日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# 可选：通知钩子（任务完成或失败时调用，POST JSON）
# WEBHOOK_URL=https://hooks.slack.com/services/...

# SMTP email delivery. QQ Mail uses the 16-character authorization code,
# not your QQ password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=your_qq_number@qq.com
SMTP_PASSWORD=your_qq_mail_authorization_code
SMTP_FROM=your_qq_number@qq.com
SMTP_TO=your_recipient@example.com
SMTP_SENDER_NAME=PHIP Analyzer
